require "base64"
require "fileutils"
require "json"
require "shellwords"
require "tmpdir"

default_platform(:ios)

before_all do
  ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] ||= "120"
end

def app_version
  JSON.parse(File.read(File.expand_path("../package.json", __dir__))).fetch("version")
end

PLAY_TRACKS = %w[internal alpha beta production].freeze

def next_play_version_code(package_name)
  codes = PLAY_TRACKS.flat_map do |track|
    begin
      google_play_track_version_codes(
        package_name: package_name,
        track: track,
        json_key: ENV["PLAY_JSON_KEY_FILE"],
      )
    rescue StandardError => e
      UI.important("Could not read '#{track}' track version codes: #{e.message}")
      []
    end
  end

  return 1 if codes.empty?
  codes.map(&:to_i).max + 1
end

IOS_APP_ID = "org.uclvolunteering.app".freeze
IOS_PROFILE = "match AppStore #{IOS_APP_ID}".freeze
IOS_PROJECT = "ios/App/App.xcodeproj".freeze

platform :ios do
  # CI maps the secrets to ASC_*; locally `doppler run -c ci` gives the full names.
  def asc_api_key
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"] || ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"] || ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"] || ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true,
    )
  end

  # Signs with the match profile and builds an .ipa. The build number is the
  # highest one on App Store Connect plus one, so laptop uploads can't collide
  # with CI (same idea as the Android versionCode).
  def build_ios(api_key, build_number: nil)
    setup_ci if ENV["CI"]

    match(type: "appstore", app_identifier: IOS_APP_ID, api_key: api_key, readonly: true)

    update_code_signing_settings(
      path: IOS_PROJECT,
      use_automatic_signing: false,
      team_id: CredentialsManager::AppfileConfig.try_fetch_value(:team_id),
      code_sign_identity: "Apple Distribution",
      profile_name: IOS_PROFILE,
      bundle_identifier: IOS_APP_ID,
      targets: ["App"],
    )

    build_number ||= latest_testflight_build_number(
      api_key: api_key,
      app_identifier: IOS_APP_ID,
      initial_build_number: 0,
    ) + 1
    UI.message("CFBundleVersion #{build_number}, CFBundleShortVersionString #{app_version}")

    increment_version_number(xcodeproj: IOS_PROJECT, version_number: app_version)
    increment_build_number(xcodeproj: IOS_PROJECT, build_number: build_number)
    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      export_options: { provisioningProfiles: { IOS_APP_ID => IOS_PROFILE } },
    )
  end

  # The App ID on the developer portal, through the API key, so a new app needs
  # no portal visit. The App Store Connect app record still has to be made by
  # hand (Apple's API can't create one), then `signing`, then `beta`.
  desc "Register the bundle ID on the Apple Developer portal"
  lane :register do
    asc_api_key
    if Spaceship::ConnectAPI::BundleId.find(IOS_APP_ID)
      UI.success("#{IOS_APP_ID} is already registered")
    else
      Spaceship::ConnectAPI::BundleId.create(name: "VolSoc", identifier: IOS_APP_ID, platform: "IOS")
      UI.success("Registered #{IOS_APP_ID}")
    end
  end

  desc "Create/refresh the App Store cert + provisioning profile in the match repo"
  lane :signing do
    match(type: "appstore", app_identifier: IOS_APP_ID, api_key: asc_api_key, readonly: false)
  end

  # Before the App Store Connect record exists there's no TestFlight to ask for
  # a build number, so this builds 1 and stops; upload it with Transporter, or
  # run `beta` once the record is there.
  desc "Build a signed .ipa without uploading"
  lane :ipa do
    build_ios(asc_api_key, build_number: (ENV["BUILD_NUMBER"] || "1").to_i)
  end

  desc "Build and upload a build to TestFlight (internal testers only)"
  lane :beta do
    api_key = asc_api_key
    build_ios(api_key)
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end

  desc "Build and upload a build to the App Store (draft)"
  lane :release do
    api_key = asc_api_key
    build_ios(api_key)
    upload_to_app_store(
      api_key: api_key,
      submit_for_review: false,
      skip_screenshots: true,
      skip_metadata: true,
      force: true,
    )
  end
end

platform :android do
  PLAY_PACKAGE_NAME = "org.uclvolunteering.app".freeze

  def prepare_android_build
    ENV["BUILD_NUMBER"] = next_play_version_code(PLAY_PACKAGE_NAME).to_s
    UI.message("versionCode #{ENV['BUILD_NUMBER']}, versionName #{app_version}")
  end

  # The Play Console only takes API uploads once an app has had one build
  # uploaded by hand, so the very first one is built here and uploaded in the
  # browser. versionCode 1.
  desc "Build a signed .aab without uploading (for the first manual upload)"
  lane :bundle do
    ENV["BUILD_NUMBER"] ||= "1"
    gradle(project_dir: "android", task: "bundleRelease")
    UI.success("android/app/build/outputs/bundle/release/app-release.aab")
  end

  desc "Build and upload a build to the Play Console internal track"
  lane :beta do
    prepare_android_build
    gradle(project_dir: "android", task: "bundleRelease")
    # The build only: the store listing (fastlane/metadata) is edited in the
    # Play Console, and pushing it from here needs a permission an upload key
    # shouldn't have, which failed every release at the final commit.
    upload_to_play_store(
      track: "internal",
      aab: "android/app/build/outputs/bundle/release/app-release.aab",
      json_key: ENV["PLAY_JSON_KEY_FILE"],
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  desc "Build and upload a build to the Play Console production track"
  lane :release do
    prepare_android_build
    gradle(project_dir: "android", task: "bundleRelease")
    upload_to_play_store(
      track: "production",
      rollout: "0.1",
      aab: "android/app/build/outputs/bundle/release/app-release.aab",
      json_key: ENV["PLAY_JSON_KEY_FILE"],
    )
  end
end
